# Ordinary users configure AI on the startup page; no .env is required.
# A saved private web configuration enables self_hosted automatically.
# demo without a saved configuration makes no paid AI calls.
# The variables below retain the advanced environment-only setup path.
# Never put secrets in NEXT_PUBLIC_* or commit .env.local.
APP_MODE=demo

# Single-owner self-hosted mode. These values are server-only.
# Use a unique random password of at least 16 characters, not your provider API key.
BOJI_SELF_HOSTED_PASSWORD=
# Exact browser origin, no trailing slash. HTTPS required except loopback localhost.
BOJI_SELF_HOSTED_ORIGIN=http://127.0.0.1:3100
# Persistent private disk, outside public/. One Node process only.
BOJI_PRIVATE_DIR=.boji-private
# Each attempt to call AI counts, including connection checks and provider failures.
# Resets by UTC date. Set 0 to deny every AI call; max 1000.
BOJI_DAILY_AI_CALL_LIMIT=40

# Separate, independent Supabase project; do not reuse the private PTE account/database.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional real writing adapter. Disabled until explicit budget/privacy review.
ENABLE_PAID_WRITING=false
OPENAI_API_KEY=
OPENAI_WRITING_MODEL=
# Conservative maximum request cost in operator-defined units, reviewed against model
# pricing and token bounds. Database budget_config defaults to zero (deny all calls).
WRITING_RESERVATION_UNITS=0

# Optional OpenAI-compatible Chat Completions infrastructure (server-only).
# Enable together with APP_MODE=self_hosted for the authenticated personal workflow.
# Demo stays free of AI calls. See docs/SELF_HOSTED_AI.md.
ENABLE_OPENAI_COMPATIBLE=false
# Base API URL; /chat/completions is appended. Example: https://api.openai.com/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_TIMEOUT_MS=20000
# Choose the token-limit parameter supported by the configured provider/model.
OPENAI_COMPAT_TOKEN_PARAMETER=max_tokens
# Explicitly allow local loopback HTTP/keyless endpoints for self-hosted testing.
OPENAI_COMPAT_ALLOW_LOCAL=false

# For dedicated LOCAL Supabase integration tests only; never put production URLs here.
BOJI_TEST_DATABASE_URL=
